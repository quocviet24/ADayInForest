  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 21300000, guid: 123444a0f4d28c24c95f96c0c0ec35c6, type: 3}
  situation: "B\u1EA1n ph\xE1t hi\u1EC7n m\u1ED9t t\xFAi r\xE1c b\u1ECB b\u1ECF l\u1EA1i
    b\xEAn c\u1EA1nh \u0111\u01B0\u1EDDng m\xF2n"
  question: "B\u1EA1n s\u1EBD l\xE0m g\xEC?"
  options:
  - answerText: "B\u1ECF qua v\xEC kh\xF4ng ph\u1EA3i r\xE1c c\u1EE7a m\xECnh"
    score: 25
    feedbackText: "B\u1EA1n kh\xF4ng t\u1EA1o ra r\xE1c, nh\u01B0ng b\u1ECF qua v\u1EABn
      c\xF3 ngh\u0129a l\xE0 v\u1EA5n \u0111\u1EC1 ti\u1EBFp t\u1EE5c t\u1ED3n t\u1EA1i"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1355774265}
          m_TargetAssemblyTypeName: Cutscene_Rac, Assembly-CSharp
          m_MethodName: ChonA_BoQua
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "Ch\u1EE5p \u1EA3nh \u0111\u1EC3 nh\u1EAFc m\u1ECDi ng\u01B0\u1EDDi
      kh\xF4ng x\u1EA3 r\xE1c"
    score: 50
    feedbackText: "Chia s\u1EBB th\xF4ng \u0111i\u1EC7p c\xF3 gi\xE1 tr\u1ECB, nh\u01B0ng
      ch\u01B0a tr\u1EF1c ti\u1EBFp gi\u1EA3i quy\u1EBFt v\u1EA5n \u0111\u1EC1 tr\u01B0\u1EDBc
      m\u1EAFt"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1355774265}
          m_TargetAssemblyTypeName: Cutscene_Rac, Assembly-CSharp
          m_MethodName: ChonB_ChupAnh
          m_Mode: 1
          m_Arguments:
