  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 21300000, guid: 123444a0f4d28c24c95f96c0c0ec35c6, type: 3}
  situation: "C\u01A1n m\u01B0a b\xE3o v\u1EEBa qua l\xE0m nhi\u1EC1u c\xE0nh c\xE2y
    g\xE3y ch\u1EAFn ngang \u0111\u01B0\u1EDDng \u0111i."
  question: "B\u1EA1n s\u1EBD x\u1EED l\xFD nh\u1EEFng c\xE0nh c\xE2y c\u1EA3n \u0111\u01B0\u1EDDng
    n\xE0y nh\u01B0 th\u1EBF n\xE0o?"
  options:
  - answerText: "B\xEA c\xE0nh c\xE2y v\u1EE9t g\u1ECDn v\xE0o b\u1EE5i r\u1EADm
      ven \u0111\u01B0\u1EDDng"
    score: 100
    feedbackText: "H\xE0nh \u0111\u1ED9ng nh\u1ECF nh\u01B0ng r\u1EA5t thi\u1EBFt
      th\u1EF1c! V\u1EEBa m\u1EDF \u0111\u01B0\u1EDDng th\xF4ng tho\xE1ng v\u1EEBa
      gi\xFAp ng\u01B0\u1EDDi \u0111i sau kh\xF4ng b\u1ECB v\u1EA5p ng\xE3."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1319371091}
          m_TargetAssemblyTypeName: Cutscene_CanhCay, Assembly-CSharp
          m_MethodName: ChonA_GomGon
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "Nh\u1EB7t m\u1ED9t c\xE0nh c\xE2y ch\u1EAFc ch\u1EAFn l\xE0m g\u1EADy
      d\xF2 \u0111\u01B0\u1EDDng leo n\xFAi."
    score: 75
    feedbackText: "R\u1EA5t th\xE1o v\xE1t! T\u1EADn d\u1EE5ng c\xE0nh c\xE2y l\xE0m
      g\u1EADy trekking gi\xFAp b\u1EA1n gi\u1EEF th\u0103ng b\u1EB1ng v\xE0 \u0111\u1EE1
      m\u1ECFi ch\xE2n khi leo d\u1ED1c."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1319371091}
          m_TargetAssemblyTypeName: Cutscene_CanhCay, Assembly-CSharp
