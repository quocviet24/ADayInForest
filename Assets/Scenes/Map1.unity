--- !u!114 &1563064301
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1563064298}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 184ec60b8a008d7438e0c671ee299ba6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 21300000, guid: 123444a0f4d28c24c95f96c0c0ec35c6, type: 3}
  situation: "\u0110i b\u1ED9 \u0111\u01B0\u1EDDng d\xE0i khi\u1EBFn b\u1EA1n \u0111\xF3i
    l\u1EA3, b\xEAn \u0111\u01B0\u1EDDng xu\u1EA5t hi\u1EC7n r\u1EA5t nhi\u1EC1u
    ch\xF9m qu\u1EA3 m\u1ECDng \u0111\u1ECF s\u1EB7c s\u1EE1."
  question: "\u0110\u1EE9ng tr\u01B0\u1EDBc nh\u1EEFng ch\xF9m qu\u1EA3 d\u1EA1i
    m\u1ECDc ven r\u1EEBng, b\u1EA1n s\u1EBD quy\u1EBFt \u0111\u1ECBnh ra sao?"
  options:
  - answerText: "Th\xF4i, tuy\u1EC7t \u0111\u1ED1i kh\xF4ng \u0103n qu\u1EA3 l\u1EA1
      kh\xF4ng r\xF5 ngu\u1ED3n g\u1ED1c."
    score: 100
    feedbackText: "Quy\u1EBFt \u0111\u1ECBnh chu\u1EA9n ch\u1EC9 c\u1EE7a d\xE2n
      \u0111i r\u1EEBng chuy\xEAn nghi\u1EC7p! Nguy\xEAn t\u1EAFc s\u1ED1ng c\xF2n:
      Tuy\u1EC7t \u0111\u1ED1i kh\xF4ng \u0103n n\u1EA5m l\u1EA1 hay qu\u1EA3 r\u1EEBng
      s\u1EB7c s\u1EE1 khi ch\u01B0a ch\u1EAFc ch\u1EAFn 100%, r\u1EA5t d\u1EC5 tr\xFAng
      \u0111\u1ED9c t\u1EED vong."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1563064302}
          m_TargetAssemblyTypeName: Cutscene_QuaLa, Assembly-CSharp
          m_MethodName: ChonA_KhongAn
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "H\xE1i \u0103n th\u1EED m\u1ED9t ch\xF9m xem ng\u1ECDt kh\xF4ng,
      \u0111\xF3i l\u1EA3 r\u1ED3i."
    score: 0
    feedbackText: "Tr\u1EDDi \u01A1i, b\u1EE5ng l\u1EA1i s\xF4i l\xEAn \xF9ng \u1EE5c,
      b\u1EAFt \u0111\u1EA7u \u0111au qu\u1EB7n th\u1EAFt r\u1ED3i k\xECa! Qu\u1EA3
      d\u1EA1i c\xF3 \u0111\u1ED9c t\xEDnh nh\u1EB9 l\xE0m b\u1EA1n hoa m\u1EAFt,
      bu\u1ED3n n\xF4n. R\xE1ng ch\u1ECBu \u0111au m\xE0 \u0111i ti\u1EBFp, b\xE0i
      h\u1ECDc nh\u1EDB \u0111\u1EDDi nha!"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1563064302}
          m_TargetAssemblyTypeName: Cutscene_QuaLa, Assembly-CSharp
          m_MethodName: ChonB_AnThu
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "H\u1ECFi ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh (Mascot) xem qu\u1EA3
      n\xE0y c\xF3 \u0103n \u0111\u01B0\u1EE3c kh\xF4ng."
    score: 80
    feedbackText: "Khoan, d\u1EEBng kho\u1EA3ng ch\u1EEBng l\xE0 2 gi\xE2y! \u0110\xE2y
      l\xE0 qu\u1EA3 d\u1EA1i c\xF3 \u0111\u1ED9c, chim th\xFA \u0103n \u0111\u01B0\u1EE3c
      ch\u1EE9 ng\u01B0\u1EDDi \u0103n v\xE0o l\xE0 ng\u1ED9 \u0111\u1ED9c c\u1EA5p
      t\xEDnh \u0111\xF3, c\u1EA5m \u0111\u1EE5ng v\xE0o nha!'"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1563064302}
          m_TargetAssemblyTypeName: Cutscene_QuaLa, Assembly-CSharp
          m_MethodName: ChonC_HoiMascot
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "Quay l\u1EA1i ch\u1ED7 b\xE3i th\u1EA3m picnic v\u1EEBa r\u1ED3i
      l\u1EA5y \u0111\u1ED3 \u0103n k\xE9 :>>"
    score: 10
    feedbackText: "\u1EE6a t\xEDnh quay l\u1EA1i \u0103n ch\u1EF1c th\u1EADt h\u1EA3
      tr\u1EDDi?! :))) V\u1EEBa t\u1ED1n s\u1EE9c cu\u1ED1c b\u1ED9 ng\u01B0\u1EE3c
      l\u1EA1i, m\xE0 kh\xE9o ch\u1EE7 th\u1EA3m v\u1EC1 b\u1EAFt g\u1EB7p l\u1EA1i
      t\u01B0\u1EDFng tr\u1ED9m th\xEC qu\xEA x\u1EC7 lu\xF4n! C\u1ED1 l\xEAn, s\u1EAFp
      t\u1EDBi tr\u1EA1m ki\u1EC3m l\xE2m c\xF3 c\u01A1m n\xF3ng r\u1ED3i!"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1563064302}
          m_TargetAssemblyTypeName: Cutscene_QuaLa, Assembly-CSharp
          m_MethodName: ChonD_QuayLaiPicnic
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  indicatorIcon: {fileID: 0}
