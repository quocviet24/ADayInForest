--- !u!114 &1041865046
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1041865045}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 184ec60b8a008d7438e0c671ee299ba6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 21300000, guid: 123444a0f4d28c24c95f96c0c0ec35c6, type: 3}
  situation: "\u0110\u1EBFn ng\xE3 ba \u0111\u01B0\u1EDDng m\xE0 kh\xF4ng r\xF5 \u0111\u01B0\u1EDDng
    \u0111i, ta n\xEAn l\xE0m g\xEC \u0111\xE2y?"
  question: "T\u1EDBi \u0111o\u1EA1n \u0111\u01B0\u1EDDng ch\u01B0a r\xF5 l\u1ED1i
    \u0111i n\xE0y, b\u1EA1n s\u1EBD quy\u1EBFt \u0111\u1ECBnh th\u1EBF n\xE0o?"
  options:
  - answerText: "Quan s\xE1t k\u1EF9 m\u1EB7t \u0111\u1EA5t t\xECm d\u1EA5u v\u1EBFt
      \u0111\u01B0\u1EDDng m\xF2n m\xF2n v\u1EB9t."
    score: 85
    feedbackText: "B\u1EA1n th\u1EADt tinh ha, tinh nh\u01B0 c\xFA \u1EA5y :>> T\xF4i
      th\u1EA5y l\u1ED1i \u0111i b\xEAn ph\u1EA3i n\xE0y tho\xE1ng h\u01A1n h\u1EB3n,
      m\u1EB7t \u0111\u1EA5t c\xF2n in v\u1EBFt m\xF2n, b\xEAn tr\xE1i th\xEC nhi\u1EC1u
      c\xE2y hoang r\u1EADm r\u1EA1p qu\xE1.."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1041865047}
          m_TargetAssemblyTypeName: Cutscene_NgaBa, Assembly-CSharp
          m_MethodName: Chon1_NhinDauVet
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "H\u1ECFi b\u1EA1n \u0111\u1ED3ng h\xE0nh (Mascot) xem c\xF3 nh\u1EDB
      \u0111\u01B0\u1EDDng kh\xF4ng."
    score: 100
    feedbackText: "C\u1EA3m \u01A1n b\u1EA1n \u0111\xE3 tin t\u01B0\u1EDFng tui ha!
      Theo tui nh\u1EDB th\xEC l\u1ED1i \u0111i n\u1EB1m \u1EDF b\xEAn ph\u1EA3i,
      c\xF3 m\u1ED9t con \u0111\u01B0\u1EDDng \u0111\xE1 m\xF2n d\u1EABn th\u1EB3ng
      qua c\u1EA7u \u0111\xF3, nh\xECn qua kia k\xECa!"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1041865047}
          m_TargetAssemblyTypeName: Cutscene_NgaBa, Assembly-CSharp
          m_MethodName: Chon2_HoiDongHanh
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "\u0110o\xE1n m\xF2 theo linh c\u1EA3m, r\u1EBD \u0111\u1EA1i m\u1ED9t
      nh\xE1nh b\u1EA5t k\u1EF3."
    score: 30
    feedbackText: "U l\xE0 tr\u1EDDi, ch\u01A1i h\u1EC7 t\xE2m linh lu\xF4n h\u1EA3
      b\u1EA1n? :)) \u0110i r\u1EEBng m\xE0 \u0111o\xE1n m\xF2 l\u1EE1 sa ch\xE2n
      v\xE0o b\u1EE5i gai hay \u0111\u1EA7m l\u1EA7y l\xE0 ti\xEAu \u0111\xF3! Th\xF4i
      theo tui, nh\xE1nh b\xEAn ph\u1EA3i tho\xE1ng h\u01A1n n\xE8!"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1041865047}
          m_TargetAssemblyTypeName: Cutscene_NgaBa, Assembly-CSharp
          m_MethodName: Chon3_DoanMo
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "B\u1ECF \u0111i\u1EC7n tho\u1EA1i ch\u1EE5p \u1EA3nh up locket:
      tui b\u1ECB l\u1EA1c \u0111\u01B0\u1EDDng r\u1ED3i"
    score: 0
    feedbackText: "Th\u1EADt lu\xF4n \u0111\xF3 ak:))"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1041865047}
          m_TargetAssemblyTypeName: Cutscene_NgaBa, Assembly-CSharp
          m_MethodName: Chon4_ChupAnhLocket
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  indicatorIcon: {fileID: 0}
