--- !u!114 &1513917362
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1513917360}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 184ec60b8a008d7438e0c671ee299ba6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 21300000, guid: 123444a0f4d28c24c95f96c0c0ec35c6, type: 3}
  situation: "Ph\xEDa tr\u01B0\u1EDBc c\xF3 m\u1EA5y ch\xFA b\xF2 \u0111ang thong
    dong g\u1EB7m c\u1ECF k\xECa. Tr\xF4ng hi\u1EC1n l\xE0nh th\u1EBF th\xF4i ch\u1EE9
    \u0111\u1EEBng d\u1EA1i m\xE0 l\xE0m phi\u1EC1n t\u1EE5ng n\xF3 nha!"
  question: "B\u1EA1n s\u1EBD l\xE0m g\xEC \u0111\xE2y?"
  options:
  - answerText: "\u0110i nh\u1EB9, gi\u1EEF kho\u1EA3ng c\xE1ch \u0111i v\xF2ng qua
      b\u1EDD b\xEAn kia."
    score: 100
    feedbackText: "Chu\u1EA9n \u0111\xE9t! Th\u1EA5y gia s\xFAc th\u1EA3 r\xF4ng
      c\u1EE9 gi\u1EEF c\u1EF1 ly an to\xE0n m\xE0 \u0111i, t\xF4n tr\u1ECDng kh\xF4ng
      gian s\u1ED1ng c\u1EE7a ch\xFAng l\xE0 b\xECnh an v\xF4 s\u1EF1"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1513917363}
          m_TargetAssemblyTypeName: Cutscene_ConBo, Assembly-CSharp
          m_MethodName: ChonA_DiVongQua
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "\u0110\u1EE9ng t\u1EEB xa ng\u1EAFm ngh\xEDa r\u1ED3i ch\u1EE5p
      \u1EA3nh."
    score: 60
    feedbackText: "C\u0169ng \u0111\u01B0\u1EE3c, l\u01B0u gi\u1EEF k\u1EF7 ni\u1EC7m
      \u0111\u1EB9p m\xE0 kh\xF4ng l\xE0m kinh \u0111\u1ED9ng \u0111\u1EBFn \u0111\xE0n
      b\xF2."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1513917363}
          m_TargetAssemblyTypeName: Cutscene_ConBo, Assembly-CSharp
          m_MethodName: ChonB_ChupAnh
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "B\u1EE9t m\u1ED9t n\u1EAFm c\u1ECF d\u1EA1i d\u01A1 ra d\u1EED b\xF2
      l\u1EA1i g\u1EA7n"
    score: 30
    feedbackText: "H\u01A1i li\u1EC1u \u0111\xF3 b\u1EA1n! B\xF2 l\u1EA1 r\u1EA5t
      d\u1EC5 b\u1ECB gi\u1EADt m\xECnh ho\u1EB7c hi\u1EC3u nh\u1EA7m b\u1EA1n mu\u1ED1n
      t\u1EA5n c\xF4ng n\xF3."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1513917363}
          m_TargetAssemblyTypeName: Cutscene_ConBo, Assembly-CSharp
          m_MethodName: ChonC_DuCo
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "Hu\xFDt s\xE1o inh \u1ECFi, l\u1EA1i g\u1EA7n v\u1ED7 m\xF4ng tr\xEAu
      b\xF2."
    score: 0
    feedbackText: "\u1ED0i, nguy hi\u1EC3m, n\xF3 n\u1ED5i \u0111i\xEAn r\u1ED3i"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1513917363}
