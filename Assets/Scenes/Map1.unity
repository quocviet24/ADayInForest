MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 225682879}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 184ec60b8a008d7438e0c671ee299ba6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 21300000, guid: 123444a0f4d28c24c95f96c0c0ec35c6, type: 3}
  situation: "B\u1EE5i r\u1EADm ven \u0111\u01B0\u1EDDng li\xEAn t\u1EE5c ph\xE1t
    ra ti\u1EBFng \u0111\u1ED9ng s\u1ED9t so\u1EA1t b\u1EA5t th\u01B0\u1EDDng."
  question: "Khi nghe th\u1EA5y ti\u1EBFng \u0111\u1ED9ng l\u1EA1 trong b\u1EE5i
    c\xE2y r\u1EADm r\u1EA1p gi\u1EEFa r\u1EEBng, b\u1EA1n s\u1EBD l\xE0m g\xEC?"
  options:
  - answerText: "D\u1EEBng l\u1EA1i quan s\xE1t t\u1EEB xa, gi\u1EEF kho\u1EA3ng
      c\xE1ch v\xE0 t\u1EEB t\u1EEB \u0111i v\xF2ng qua."
    score: 100
    feedbackText: "R\u1EA5t t\u1EC9nh t\xE1o! \u0110\u1ED9ng v\u1EADt hoang d\xE3
      ch\u1EC9 t\u1EF1 v\u1EC7 khi b\u1ECB \u0111e d\u1ECDa. Gi\u1EEF c\u1EF1 ly
      an to\xE0n l\xE0 c\xE1ch b\u1EA3o v\u1EC7 c\u1EA3 b\u1EA1n l\u1EABn th\xFA
      r\u1EEBng."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 225682883}
          m_TargetAssemblyTypeName: Cutscene_BuiCay, Assembly-CSharp
          m_MethodName: ChonA_QuanSat
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "C\u1EA7m c\xE0nh c\xE2y g\xF5 m\u1EA1nh xu\u1ED1ng m\u1EB7t \u0111\u1EA5t
      \u0111\u1EC3 t\u1EA1o ti\u1EBFng \u0111\u1ED9ng xua \u0111u\u1ED5i."
    score: 50
    feedbackText: "Gi\u1EA3i ph\xE1p t\u1EA1m \u1ED5n \u0111\u1EC3 \u0111u\u1ED5i
      r\u1EAFn r\u1EBFt. Tuy nhi\xEAn n\u1EBFu b\xEAn trong l\xE0 th\xFA d\u1EEF
      ho\u1EB7c t\u1ED5 ong, ti\u1EBFng \u0111\u1ED9ng l\u1EDBn c\xF3 th\u1EC3 k\xEDch
      \u0111\u1ED9ng ch\xFAng t\u1EA5n c\xF4ng."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 225682883}
          m_TargetAssemblyTypeName: Cutscene_BuiCay, Assembly-CSharp
          m_MethodName: ChonB_GoGay
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "Nh\u1EB9 nh\xE0ng ti\u1EBFn l\u1EA1i g\u1EA7n v\u1EA1ch l\xE1 ra
      xem v\xE0 cho m\u1EA9u th\u1EE9c \u0103n."
    score: 25
    feedbackText: "R\u1EA5t nguy hi\u1EC3m! B\u1EA5t ng\u1EDD v\u1EA1ch l\xE1 d\u1EC5
      b\u1ECB \u0111\u1ED9ng v\u1EADt c\u1EAFn t\u1EF1 v\u1EC7. Ngo\xE0i ra th\u1EE9c
      \u0103n c\u1EE7a ng\u01B0\u1EDDi c\xF3 th\u1EC3 l\xE0m th\xFA r\u1EEBng b\u1ECB
      ng\u1ED9 \u0111\u1ED9c \u0111\u01B0\u1EDDng ru\u1ED9t."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 225682883}
