  panSpeed: 3.5
  pauseAtTarget: 1
  mascotAdvice: "\u0110\u01B0\u1EDDng b\xEAn ph\u1EA3i tr\xF4ng c\xF3 v\u1EBB b\u1EB1ng
    ph\u1EB3ng v\xE0 c\xF3 bi\u1EC3n ch\u1EC9 d\u1EABn r\xF5 r\xE0ng h\u01A1n k\xECa,
    ch\xFAng ta n\xEAn \u0111i h\u01B0\u1EDBng \u0111\xF3 nh\xE9!"
  introDialogue: "\u1EE6a khoan... \u0110i t\u1EDBi \u0111\xE2y t\u1EF1 d\u01B0ng
    chia hai ng\u1EA3 v\u1EADy n\xE8? C\xE2y c\u1ED1i che khu\u1EA5t h\u1EBFt tr\u01A1n,
    kh\xF4ng bi\u1EBFt \u0111\u01B0\u1EDDng n\xE0o m\u1EDBi l\xEAn ch\u1ED7 ch\xFA
    L\xE2m. T\xEDnh sao \u0111\xE2y b\u1EA1n \u01A1i?"
