--- !u!114 &918777281
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 918777279}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 184ec60b8a008d7438e0c671ee299ba6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 21300000, guid: 123444a0f4d28c24c95f96c0c0ec35c6, type: 3}
  situation: "M\u1ED9t b\xE3i picnic c\xF3 \u0111\u1EA7y \u0111\u1EE7 th\u1EA3m tr\u1EA3i,
    gi\u1ECF \u0111\u1ED3 v\xE0 th\u1EE9c \u0103n nh\u01B0ng kh\xF4ng c\xF3 ai tr\xF4ng
    coi."
  question: "B\u1EAFt g\u1EB7p \u0111\u1ED3 d\xE3 ngo\u1EA1i c\u1EE7a ng\u01B0\u1EDDi
    kh\xE1c \u0111\u1EC3 l\u1EA1i gi\u1EEFa r\u1EEBng m\xE0 kh\xF4ng c\xF3 ai, b\u1EA1n
    s\u1EBD l\xE0m g\xEC?"
  options:
  - answerText: "T\xF4n tr\u1ECDng t\u01B0 trang ng\u01B0\u1EDDi kh\xE1c, kh\xF4ng
      \u0111\u1EE5ng v\xE0o v\xE0 \u0111i ti\u1EBFp."
    score: 100
    feedbackText: "R\u1EA5t v\u0103n minh! \u0110i r\u1EEBng hay b\u1EA5t k\u1EF3
      n\u01A1i c\xF4ng c\u1ED9ng n\xE0o, kh\xF4ng t\u1EF1 ti\u1EC7n x\xE2m ph\u1EA1m
      \u0111\u1ED3 \u0111\u1EA1c c\u1EE7a ng\u01B0\u1EDDi kh\xE1c l\xE0 ph\xE9p l\u1ECBch
      s\u1EF1 c\u01A1 b\u1EA3n."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 918777282}
          m_TargetAssemblyTypeName: Cutscene_Picnic, Assembly-CSharp
          m_MethodName: ChonA_DiTiep
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "T\xF2 m\xF2 b\u01B0\u1EDBc v\xE0o xem th\u1EED h\u1ECD mang theo
      nh\u1EEFng m\xF3n \u0111\u1ED3 d\xE3 ngo\u1EA1i g\xEC."
    score: 50
    feedbackText: "T\xF2 m\xF2 l\xE0 b\xECnh th\u01B0\u1EDDng, nh\u01B0ng l\u1EA3ng
      v\u1EA3ng quanh \u0111\u1ED3 \u0111\u1EA1c ng\u01B0\u1EDDi kh\xE1c khi h\u1ECD
      v\u1EAFng m\u1EB7t r\u1EA5t d\u1EC5 b\u1ECB hi\u1EC3u l\u1EA7m l\xE0 c\xF3
      \xFD \u0111\u1ED3 x\u1EA5u \u0111\u1EA5y nh\xE9!"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 918777282}
          m_TargetAssemblyTypeName: Cutscene_Picnic, Assembly-CSharp
          m_MethodName: ChonB_NgoNghieng
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "L\u1EA5y tr\u1ED9m h\u1ED9p s\u1EEFa tr\xEAn th\u1EA3m u\u1ED1ng
      v\xEC ngh\u0129 gi\u1EEFa r\u1EEBng kh\xF4ng ai th\u1EA5y."
    score: 0
    feedbackText: "\u1EE6a alo?! H\xE0nh vi n\xE0y l\xE0 tr\u1ED9m c\u1EAFp r\u1ED3i
      nha b\u1EA1n! V\u1EEBa b\u1ECB tr\u1EEB \u0111i\u1EC3m \u0111\u1EA1o \u0111\u1EE9c,
      v\u1EEBa u\u1ED1ng ph\u1EA3i \u0111\u1ED3 \u0111\u1EC3 ngo\xE0i n\u1EAFng thiu
      h\u1ECFng th\xEC \u0111au b\u1EE5ng r\xE1ng ch\u1ECBu!"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 918777282}
          m_TargetAssemblyTypeName: Cutscene_Picnic, Assembly-CSharp
          m_MethodName: ChonC_TromSua
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "\u0110\u1EE9ng quan s\xE1t xung quanh xem ch\u1EE7 nh\xE2n c\xF3
      \u1EDF g\u1EA7n ho\u1EB7c c\u1EA7n h\u1ED7 tr\u1EE3 kh\xF4ng"
    score: 80
    feedbackText: "R\u1EA5t chu \u0111\xE1o v\xE0 c\xF3 \xFD th\u1EE9c! Gi\u1EEFa
      r\u1EEBng v\u1EAFng th\u1EA5y \u0111\u1ED3 \u0111\u1EA1c b\u1ECF l\u1EA1i,
      \u0111\u1EC3 m\u1EAFt quan s\xE1t xem c\xF3 ai tr\u01B0\u1EE3t ch\xE2n hay
      g\u1EB7p s\u1EF1 c\u1ED1 c\u1EA7n tr\u1EE3 gi\xFAp l\xE0 ph\u1EA3n x\u1EA1
      r\u1EA5t t\u1ED1t. Khi th\u1EA5y an to\xE0n r\u1ED3i th\xEC m\xECnh ti\u1EBFp
      t\u1EE5c \u0111i th\xF4i."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 918777282}
          m_TargetAssemblyTypeName: Cutscene_Picnic, Assembly-CSharp
          m_MethodName: ChonD_QuanSatGiupDo
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  indicatorIcon: {fileID: 0}
