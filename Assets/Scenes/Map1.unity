--- !u!114 &1780398171
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1780398169}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 184ec60b8a008d7438e0c671ee299ba6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 21300000, guid: 123444a0f4d28c24c95f96c0c0ec35c6, type: 3}
  situation: "M\u1ED9t thanh ni\xEAn \u0111ang th\u1EA3n nhi\xEAn gi\u1EABm \u0111\u1EA1p
    l\xEAn lu\u1ED1ng hoa r\u1EEBng \u0111\u1EC3 t\u1EA1o d\xE1ng ch\u1EE5p \u1EA3nh."
  question: "Th\u1EA5y h\xE0nh vi gi\u1EABm \u0111\u1EA1p ph\xE1 ho\u1EA1i hoa c\u1ECF
    trong r\u1EEBng, b\u1EA1n s\u1EBD \u1EE9ng x\u1EED th\u1EBF n\xE0o?"
  options:
  - answerText: "M\u1EB7c k\u1EC7 b\u1ECF qua, chuy\u1EC7n ng\u01B0\u1EDDi ta kh\xF4ng
      li\xEAn quan t\u1EDBi m\xECnh."
    score: 30
    feedbackText: "Im l\u1EB7ng b\u1ECF \u0111i th\xEC an to\xE0n th\u1EADt, nh\u01B0ng
      n\u1EBFu ai c\u0169ng l\xE0m ng\u01A1 th\xEC ch\u1EB3ng m\u1EA5y ch\u1ED1c
      c\xE1nh r\u1EEBng s\u1EBD b\u1ECB gi\u1EABm n\xE1t hoang t\xE0n."
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1780398172}
          m_TargetAssemblyTypeName: Cutscene_ThanhNien, Assembly-CSharp
          m_MethodName: ChonA_MacKe
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "Gi\u01A1 \u0111i\u1EC7n tho\u1EA1i l\xEAn ch\u1EE5p \u1EA3nh l\u1EA1i
      l\xE0m b\u1EB1ng ch\u1EE9ng b\xF3c ph\u1ED1t."
    score: 10
    feedbackText: 
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1780398172}
          m_TargetAssemblyTypeName: Cutscene_ThanhNien, Assembly-CSharp
          m_MethodName: ChonB_ChupAnh
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "i\u1EBFn l\u1EA1i g\u1EA7n, nh\u1EB9 nh\xE0ng nh\u1EAFc nh\u1EDF
      v\xE0 khuy\xEAn ng\u0103n b\u1EA1n \u1EA5y."
    score: 100
    feedbackText: 
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1780398172}
          m_TargetAssemblyTypeName: Cutscene_ThanhNien, Assembly-CSharp
          m_MethodName: ChonC_KhuyenNgan
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "Ch\u1EEDi th\u1EB3ng m\u1EB7t: \"Th\u1EB1ng ch\xF3a kia, ai cho
      m\xE0y d\u1EABm l\xEAn hoa?!\""
    score: 0
    feedbackText: 
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1780398172}
          m_TargetAssemblyTypeName: Cutscene_ThanhNien, Assembly-CSharp
          m_MethodName: ChonD_ChuiBoi
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
