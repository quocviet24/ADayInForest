--- !u!114 &1090121054
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1090121053}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 184ec60b8a008d7438e0c671ee299ba6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 0}
  situation: "\u201CB\u1EA1n ph\xE1t hi\u1EC7n m\u1ED9t t\xFAi r\xE1c b\u1ECB b\u1ECF
    l\u1EA1i b\xEAn c\u1EA1nh \u0111\u01B0\u1EDDng m\xF2n.\u201D\r\n"
  question: "B\u1EA1n s\u1EBD l\xE0m g\xEC?"
  options:
  - answerText: "A. B\u1ECF qua v\xEC kh\xF4ng ph\u1EA3i r\xE1c c\u1EE7a m\xECnh"
    score: 25
    feedbackText: "\u201CB\u1EA1n kh\xF4ng t\u1EA1o ra r\xE1c, nh\u01B0ng b\u1ECF
      qua v\u1EABn c\xF3 ngh\u0129a l\xE0 v\u1EA5n \u0111\u1EC1 ti\u1EBFp t\u1EE5c
      t\u1ED3n t\u1EA1i.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  - answerText: "B. Ch\u1EE5p \u1EA3nh \u0111\u1EC3 nh\u1EAFc m\u1ECDi ng\u01B0\u1EDDi
      kh\xF4ng x\u1EA3 r\xE1c"
    score: 50
    feedbackText: "\u201CChia s\u1EBB th\xF4ng \u0111i\u1EC7p c\xF3 gi\xE1 tr\u1ECB,
      nh\u01B0ng ch\u01B0a tr\u1EF1c ti\u1EBFp gi\u1EA3i quy\u1EBFt v\u1EA5n \u0111\u1EC1
      tr\u01B0\u1EDBc m\u1EAFt.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  - answerText: "C. Nh\u1EB7t l\xEAn n\u1EBFu \u0111i\u1EC1u ki\u1EC7n an to\xE0n
      v\xE0 x\u1EED l\xFD \u0111\xFAng n\u01A1i/quy \u0111\u1ECBnh"
    score: 100
    feedbackText: "\u201CM\u1ED9t h\xE0nh \u0111\u1ED9ng nh\u1ECF c\u1EE7a ng\u01B0\u1EDDi
      tham quan c\u0169ng g\xF3p ph\u1EA7n gi\u1EA3m t\xE1c \u0111\u1ED9ng l\xEAn
      m\xF4i tr\u01B0\u1EDDng.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1090121053}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - answerText: "D. \u0110\xE1 t\xFAi r\xE1c v\xE0o s\xE2u trong b\u1EE5i c\xE2y"
    score: 25
    feedbackText: "\u201CR\xE1c bi\u1EBFn m\u1EA5t kh\u1ECFi t\u1EA7m m\u1EAFt kh\xF4ng
      c\xF3 ngh\u0129a l\xE0 bi\u1EBFn m\u1EA5t kh\u1ECFi m\xF4i tr\u01B0\u1EDDng.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  indicatorIcon: {fileID: 0}
