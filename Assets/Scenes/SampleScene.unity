--- !u!114 &1624591298
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1624591297}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 184ec60b8a008d7438e0c671ee299ba6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 0}
  situation: "\u201CB\u1EA1n chu\u1EA9n b\u1ECB b\u1EAFt \u0111\u1EA7u h\xE0nh tr\xECnh.
    Ph\xEDa tr\u01B0\u1EDBc l\xE0 m\u1ED9t khu v\u1EF1c c\xF3 c\xE1c quy \u0111\u1ECBnh
    ri\xEAng.\u201D"
  question: "B\u1EA1n s\u1EBD l\xE0m g\xEC tr\u01B0\u1EDBc khi ti\u1EBFp t\u1EE5c
    \u0111i ti\u1EBFp?\r"
  options:
  - answerText: "A. \u0110i th\u1EB3ng v\xEC m\xECnh ch\u1EC9 tham quan m\u1ED9t
      l\xFAc"
    score: 50
    feedbackText: "\u201CTh\u1EDDi gian tham quan ng\u1EAFn kh\xF4ng c\xF3 ngh\u0129a
      l\xE0 c\xE1c quy \u0111\u1ECBnh c\xF3 th\u1EC3 b\u1ECF qua.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  - answerText: "B. Quan s\xE1t xem m\u1ECDi ng\u01B0\u1EDDi kh\xE1c \u0111ang l\xE0m
      g\xEC"
    score: 75
    feedbackText: "\u201CQuan s\xE1t ng\u01B0\u1EDDi kh\xE1c c\xF3 th\u1EC3 gi\xFAp
      b\u1EA1n \u0111\u1ECBnh h\u01B0\u1EDBng, nh\u01B0ng hi\u1EC3u quy \u0111\u1ECBnh
      c\u1EE7a ch\xEDnh khu v\u1EF1c m\u1EDBi l\xE0 \u0111i\u1EC1u quan tr\u1ECDng.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  - answerText: "C. \u0110\u1ECDc b\u1EA3ng v\xE0 x\xE1c \u0111\u1ECBnh nh\u1EEFng
      \u0111i\u1EC1u m\xECnh c\u1EA7n tu\xE2n th\u1EE7"
    score: 100
    feedbackText: "\u201CM\u1ED9t chuy\u1EBFn \u0111i an to\xE0n b\u1EAFt \u0111\u1EA7u
      t\u1EEB vi\u1EC7c bi\u1EBFt m\xECnh \u0111ang \u1EDF \u0111\xE2u v\xE0 m\xECnh
      c\u1EA7n t\xF4n tr\u1ECDng \u0111i\u1EC1u g\xEC.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  - answerText: "D. B\u1ECF qua v\xEC ngh\u0129 \u0111\xE3 c\xF3 ki\u1EC3m l\xE2m
      qu\u1EA3n l\xFD "
    score: 25
    feedbackText: "\u201CC\xF3 l\u1EF1c l\u01B0\u1EE3ng qu\u1EA3n l\xFD kh\xF4ng
      c\xF3 ngh\u0129a ng\u01B0\u1EDDi tham quan \u0111\u01B0\u1EE3c b\u1ECF qua
      tr\xE1ch nhi\u1EC7m c\u1EE7a m\xECnh.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  indicatorIcon: {fileID: 0}
