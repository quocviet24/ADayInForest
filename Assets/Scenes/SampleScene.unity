  warningText2: "Th\u1EDDi ti\u1EBFt chuy\u1EC3n x\u1EA5u c\xF3 m\u01B0a v\xE0 s\u1EA5m
    s\xE9t r\u1ED3i, ta c\u1EA7n l\xE0m g\xEC \u0111\xE2y?"
--- !u!114 &933907531
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 933907527}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 184ec60b8a008d7438e0c671ee299ba6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterName: "Ng\u01B0\u1EDDi \u0111\u1ED3ng h\xE0nh"
  avatarIcon: {fileID: 21300000, guid: 123444a0f4d28c24c95f96c0c0ec35c6, type: 3}
  situation: "\u201CM\xE2y k\xE9o t\u1EDBi nhanh. Gi\xF3 m\u1EA1nh h\u01A1n v\xE0
    \u0111\u01B0\u1EDDng b\u1EAFt \u0111\u1EA7u tr\u01A1n.\u201D\r\n"
  question: "B\u1EA1n \u01B0u ti\xEAn \u0111i\u1EC1u g\xEC?"
  options:
  - answerText: "A. C\u1ED1 \u0111i th\u1EADt nhanh \u0111\u1EC3 ho\xE0n th\xE0nh
      h\xE0nh tr\xECnh  "
    score: 50
    feedbackText: "\u201CB\u1EA1n \u01B0u ti\xEAn ti\u1EBFn \u0111\u1ED9, nh\u01B0ng
      \u0111i\u1EC1u ki\u1EC7n m\xF4i tr\u01B0\u1EDDng \u0111\xE3 thay \u0111\u1ED5i.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  - answerText: "B. H\u1ECFi m\u1ED9t kh\xE1ch kh\xE1c xem n\xEAn \u0111i ti\u1EBFp
      kh\xF4ng  "
    score: 75
    feedbackText: "\u201CTham kh\u1EA3o th\xEAm th\xF4ng tin l\xE0 t\u1ED1t, nh\u01B0ng
      v\u1EABn c\u1EA7n d\u1EF1a v\xE0o h\u01B0\u1EDBng d\u1EABn ch\xEDnh th\u1EE9c
      c\u1EE7a khu v\u1EF1c.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  - answerText: "C. Ki\u1EC3m tra th\xF4ng tin v\xE0 c\xE2n nh\u1EAFc d\u1EEBng/\u0111\u1ED5i
      tuy\u1EBFn theo h\u01B0\u1EDBng d\u1EABn  "
    score: 100
    feedbackText: "\u201CBi\u1EBFt thay \u0111\u1ED5i k\u1EBF ho\u1EA1ch khi \u0111i\u1EC1u
      ki\u1EC7n thay \u0111\u1ED5i c\u0169ng l\xE0 m\u1ED9t ph\u1EA7n c\u1EE7a an
      to\xE0n.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  - answerText: "D. B\u1ECF qua v\xEC ngh\u0129 m\u01B0a s\u1EBD t\u1EA1nh nhanh  "
    score: 25
    feedbackText: "\u201CD\u1EF1 \u0111o\xE1n ch\u1EE7 quan c\xF3 th\u1EC3 khi\u1EBFn
      b\u1EA1n \u0111\xE1nh gi\xE1 th\u1EA5p r\u1EE7i ro.\u201D\r\n\r\n"
    onChooseEvent:
      m_PersistentCalls:
        m_Calls: []
  indicatorIcon: {fileID: 0}
